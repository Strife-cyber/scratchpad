{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://scratchpad.dev/schemas/suite.schema.json",
  "title": "Scratchpad YAML suite",
  "description": "A Scratchpad test suite. A suite is either a single mapping (one suite), a list of mappings each with 'steps' (many suites), or a list of step mappings (a single unnamed suite).",
  "oneOf": [
    { "$ref": "#/definitions/suite" },
    { "$ref": "#/definitions/suiteList" },
    { "$ref": "#/definitions/stepList" }
  ],
  "definitions": {
    "suite": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "name": { "type": "string" },
        "platform": { "enum": ["", "web", "android"] },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Secrets for this suite. Values may be plain or ${VAR} references resolved from the process environment. Never logged."
        },
        "tags": { "$ref": "#/definitions/tags" },
        "timeout": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "screenshot_on_failure": { "type": "boolean" },
        "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } }
      },
      "additionalProperties": false
    },
    "suiteList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/suite" }
    },
    "stepList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    },
    "step": {
      "type": "object",
      "description": "A step has exactly one action key plus optional per-step options (timeout, retries, screenshot_on_failure, tag/tags).",
      "properties": {
        "navigate": { "type": "string", "minLength": 1 },
        "wait": { "$ref": "#/definitions/wait" },
        "type": { "$ref": "#/definitions/type" },
        "click": { "$ref": "#/definitions/click" },
        "assert": { "$ref": "#/definitions/assert" },
        "observe": { "type": ["null", "object"] },
        "select_option": { "$ref": "#/definitions/select_option" },
        "execute_js": { "$ref": "#/definitions/execute_js" },
        "scroll": { "$ref": "#/definitions/scroll" },
        "press_key": { "$ref": "#/definitions/press_key" },
        "press_key_combo": { "$ref": "#/definitions/press_key_combo" },
        "check": { "$ref": "#/definitions/check_uncheck" },
        "uncheck": { "$ref": "#/definitions/check_uncheck" },
        "timeout": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "screenshot_on_failure": { "type": "boolean" },
        "tag": { "type": "string" },
        "tags": { "$ref": "#/definitions/tags" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["navigate"] },
        { "required": ["wait"] },
        { "required": ["type"] },
        { "required": ["click"] },
        { "required": ["assert"] },
        { "required": ["observe"] },
        { "required": ["select_option"] },
        { "required": ["execute_js"] },
        { "required": ["scroll"] },
        { "required": ["press_key"] },
        { "required": ["press_key_combo"] },
        { "required": ["check"] },
        { "required": ["uncheck"] }
      ]
    },
    "selector": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "css": { "type": "string" },
            "xpath": { "type": "string" },
            "text": { "type": "string" },
            "role": { "type": "string" },
            "test_id": { "type": "string" },
            "placeholder": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "wait": {
      "type": "object",
      "properties": {
        "selector": { "$ref": "#/definitions/selector" },
        "condition": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "object",
      "required": ["selector", "text"],
      "properties": {
        "selector": { "$ref": "#/definitions/selector" },
        "text": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "click": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "properties": {
            "selector": { "$ref": "#/definitions/selector" },
            "timeout": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    },
    "assert": {
      "type": "object",
      "properties": {
        "selector": { "$ref": "#/definitions/selector" },
        "text": { "type": "string" },
        "contains": { "type": "boolean" },
        "matches": { "type": "boolean" },
        "equals": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "exists": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0 },
        "attr": { "type": "string" },
        "value": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "no_console_errors": { "type": "boolean" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["contains"] },
        { "required": ["matches"] },
        { "required": ["equals"] },
        { "required": ["visible"] },
        { "required": ["exists"] },
        { "required": ["checked"] },
        { "required": ["text"] },
        { "required": ["count"] },
        { "required": ["attr"] },
        { "required": ["url"] },
        { "required": ["title"] },
        { "required": ["no_console_errors"] }
      ],
      "dependencies": {
        "attr": ["value"],
        "value": ["attr"]
      }
    },
    "select_option": {
      "type": "object",
      "required": ["selector"],
      "properties": {
        "selector": { "$ref": "#/definitions/selector" },
        "option_value": { "type": "string" },
        "option_text": { "type": "string" },
        "timeout": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["option_value"] },
        { "required": ["option_text"] }
      ]
    },
    "execute_js": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["js"],
          "properties": { "js": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      ]
    },
    "scroll": {
      "type": "object",
      "required": ["direction"],
      "properties": {
        "selector": { "$ref": "#/definitions/selector" },
        "direction": { "enum": ["up", "down", "left", "right"] },
        "amount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "press_key": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "modifiers": { "$ref": "#/definitions/modifiers" },
        "timeout": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "press_key_combo": {
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "ctrl": { "type": "boolean" },
        "alt": { "type": "boolean" },
        "shift": { "type": "boolean" },
        "meta": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "modifiers": {
      "type": "object",
      "properties": {
        "ctrl": { "type": "boolean" },
        "alt": { "type": "boolean" },
        "shift": { "type": "boolean" },
        "meta": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "check_uncheck": {
      "type": "object",
      "required": ["selector"],
      "properties": {
        "selector": { "$ref": "#/definitions/selector" },
        "timeout": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tags": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
